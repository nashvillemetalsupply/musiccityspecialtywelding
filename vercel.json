{
  "installCommand": "npm ci",
  "crons": [
    {
      "path": "/api/ops/digest",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/ingest/gmail",
      "schedule": "5 12 * * *"
    },
    {
      "path": "/api/ingest/gmail",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/health/monitor",
      "schedule": "5,20,35,50 * * * *"
    },
    {
      "path": "/api/ops/brief",
      "schedule": "30 12 * * *"
    },
    {
      "path": "/api/ops/reminders",
      "schedule": "0 14 * * *"
    }
  ]
}
