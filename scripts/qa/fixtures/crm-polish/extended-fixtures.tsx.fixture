import { randomUUID } from "node:crypto"
import Link from "next/link"
import Image from "next/image"
import type { CSSProperties } from "react"
import { BoardRouteNav } from "../board-route-nav"
import { SkipLink } from "../skip-link"
import { ThemeBoot } from "../theme-boot"
import { WireStrip, type WireSlip } from "../../ops/wire-strip"
import { BuildSheetDrawing } from "../../../components/build-sheets/build-sheet-drawing"
import { CallSketchPrototype } from "../../../components/call-sketch/call-sketch-prototype"
import { LoginFixture, DockFixture } from "./fixture-tools"
import { VoiceFixture } from "./voice-fixture"
import { PaymentCheckFixture } from "./payment-check"

const customer = "[INTERNAL TEST] Alexander Montgomery-Washington & Riverbend Fabrication Equipment Services"
const need = "Repair the cracked trailer tongue and reinforce the mounting brackets. Confirm the opening width, hinge clearance, finish, and delivery access before cutting any material."
export const extendedSurfaces = ["calls", "updates", "analytics", "install", "builds", "sketch", "login", "customer", "dock", "voice", "payment-check"]

export function ExtendedFixture({ surface, state, owner }: { surface: string; state: string; owner: boolean }) {
  const fixtureDomPrefix = `qa-build-${randomUUID()}`
  const empty = state === "empty"
  if (surface === "login") return <LoginFixture state={state} />
  if (surface === "dock") return <DockFixture state={state} />
  if (surface === "voice") return <VoiceFixture />
  if (surface === "payment-check") return <PaymentCheckFixture />
  if (surface === "sketch") return owner ? <div data-qa-local-interactions><CallSketchPrototype embedded /></div> : <div className="sketch-gate-page"><section className="card sketch-gate"><p className="t-label">Owner workspace</p><h1 className="t-title">Call Sketch</h1><p>Live and practice sketches are available to the owner.</p><Link href="/board">Back to Jobs</Link></section></div>
  if (surface === "calls") return <><SkipLink /><ThemeBoot /><main id="main" tabIndex={-1} className="calls">
    <header className="calls-top"><Link className="btn btn--edge" href="/board">Board</Link><h1 className="t-title">Calls to review</h1><span className="calls-count t-label">{empty ? 0 : 1284} calls</span></header>
    {empty ? <p className="calls-empty t-data">No calls to review.</p> : <div className="calls-list">{["missed", "ringing", "ready"].map((status, index) => <article className="calls-row" key={status}><div className="calls-copy"><span className={`chip chip--${index === 0 ? "warn" : index === 1 ? "info" : "good"}`}><i />{index === 0 ? "Missed call" : index === 1 ? "On the phone now · being read" : "Call ready"}</span><span className="t-caption">Oct 29, 12:42 PM</span><strong className="calls-who t-data">{customer}</strong><p className="t-caption">(615) 555-0100</p><p className="calls-need t-caption">{need}</p></div><Link className="btn btn--go" href="/board/qa-polish?surface=forms">Review</Link></article>)}</div>}
    {!empty && <nav className="calls-pages" aria-label="Calls to review pages"><span /><span className="t-label">Page 1 of 129</span><Link className="btn btn--edge" href="/board/calls?page=2">Older</Link></nav>}
  </main><BoardRouteNav current="calls" role={owner ? "owner" : "crew"} /></>
  if (surface === "updates") {
    const slips: WireSlip[] = empty ? [] : ["quote-capture", "attach-payment", "contact-intro", "departure-confirm"].map((kind, index) => ({ id: 8000000 + index, stock: index === 0 ? "warn" : "info", title: `${customer}: ${index === 1 ? "QuickBooks receipt needs a job" : "Confirm the next step"}`, body: need, url: "/ops/leads/987654321", age: "12 minutes", actionKind: kind, actionDetail: {} }))
    return <><SkipLink /><ThemeBoot /><main id="main" tabIndex={-1} className="updates-page"><header className="updates-head"><div><p className="t-label">Job Control</p><h1 className="t-title">Updates</h1></div><Link className="btn btn--edge" href="/board">Back to board</Link></header>
      <WireStrip slips={slips} unreadTotal={empty ? 0 : 1284} history={state === "history"} page={1} hasOlder={!empty} query={state === "history" ? "Riverbend gate repair" : ""} />
      {owner && <section className="updates-delivery" aria-labelledby="delivery-title"><header><div><p className="t-label">Delivery</p><h2 className="t-title" id="delivery-title">Recent failures</h2></div><span className="t-caption">Last 24 hours</span></header>{empty ? <p className="updates-delivery-empty t-caption">No recent delivery failures.</p> : <ul><li><div><strong>{customer}</strong><time>12:42 PM</time></div><p>Customer message could not be delivered. The carrier returned a temporary error; check the number before trying again.</p></li></ul>}</section>}
    </main><BoardRouteNav current="updates" role={owner ? "owner" : "crew"} /></>
  }
  if (surface === "analytics") {
    if (empty || !owner) return <div className="analytics-page analytics-state-page"><section className="card analytics-state"><h1 className="t-title">Shop Analytics</h1><p>{owner ? "The operations database is not configured." : "Owner access required. The production page redirects crew."}</p></section></div>
    return <div className="analytics-page"><header className="card analytics-head"><div><Link className="analytics-back t-caption" href="/board">Back to Jobs</Link><span className="t-label">Owner only</span><h1 className="t-title">Shop Analytics</h1><p className="t-caption">Business totals without crew rankings.</p></div></header><nav className="analytics-ranges" aria-label="Analytics period">{[30, 90, 365].map(days => <Link className={`btn btn--sm btn--edge${days === 30 ? " is-active" : ""}`} key={days} href={`/ops/analytics?range=${days}`} aria-current={days === 30 ? "page" : undefined}>{days} days</Link>)}</nav>
      <section className="card analytics-card"><header><div><span className="t-label">September 30 – October 29, 2026</span><h2 className="t-sub">Current vs prior period</h2></div><p className="t-caption">Compared with August 31 – September 29</p></header><div className="analytics-table-wrap" role="region" aria-label="Period totals table" tabIndex={0}><table className="analytics-table"><caption className="t-caption">Shop totals for equal lead-arrival periods</caption><thead><tr>{["Measure", "Current", "Prior", "Change"].map(label => <th key={label} scope="col">{label}</th>)}</tr></thead><tbody>{["Leads received", "Booked jobs", "Conversion", "Known revenue", "Paid", "Unpaid invoice balance", "Median first response"].map((label, index) => <tr key={label}><th scope="row">{label}</th><td data-label="Current">{index > 2 && index < 6 ? "$1,234,567.89" : "1,284"}</td><td data-label="Prior">{index > 2 && index < 6 ? "$987,654.32" : "1,024"}</td><td data-label="Change">+25.4%</td></tr>)}</tbody></table></div></section>
      <section className="card analytics-card"><header><div><span className="t-label">Top seven plus other</span><h2 className="t-sub" id="lead-sources-heading">Lead sources</h2></div></header><div className="analytics-table-wrap" role="region" aria-label="Lead sources table" tabIndex={0}><table className="analytics-table"><caption className="t-caption">Lead source and booking results</caption><thead><tr>{["Source", "Current leads", "Current booked", "Conversion", "Prior leads"].map(label => <th key={label} scope="col">{label}</th>)}</tr></thead><tbody>{["Google Ads – very long campaign and referral description", "Customer referral", "Unattributed"].map(label => <tr key={label}><th scope="row">{label}</th><td data-label="Current leads">1,284</td><td data-label="Current booked">1,024</td><td data-label="Conversion">79.8%</td><td data-label="Prior leads">982</td></tr>)}</tbody></table></div></section><aside className="card analytics-method"><h2 className="t-sub">How this is counted</h2><p>Internal tests are excluded. These synthetic figures exercise layout only. Business totals do not rank individual crew members.</p></aside>
    </div>
  }
  if (surface === "install") return <div className="install-page"><header className="card install-head"><Link className="install-back t-caption" href="/board">Back to Jobs</Link><h1 className="t-title">Install MCSW Jobs</h1><p className="t-caption">Put Jobs on this phone&apos;s home screen.</p></header><div className="install-action"><button className="btn btn--go" type="button" disabled={state === "pending"}>{state === "pending" ? "MCSW Jobs installed" : "Install MCSW Jobs"}</button>{state === "failed" && <p className="t-caption" role="status">Use the Chrome menu steps below.</p>}</div><section className="card install-steps"><h2 className="t-sub">If Install does not appear</h2><ol><li>Tap the three-dot Chrome menu.</li><li>Tap <strong>Install app</strong> or <strong>Add to Home screen</strong>.</li><li>Confirm <strong>MCSW Jobs</strong>.</li></ol></section><section className="card install-steps" aria-label="iPhone or iPad installation"><h2 className="t-sub">iPhone or iPad</h2><ol><li>Tap <strong>Share</strong>.</li><li>Tap <strong>Add to Home Screen</strong>.</li></ol></section><p className="install-note t-caption">This phone stays signed in for up to 90 days. Keep it locked.</p></div>
  if (surface === "builds") return <div className="ops-builds"><header className="ops-builds-header"><div><p className="t-caption">Job #TEST-1</p><h1 className="t-title">Fabrication</h1><span>{customer}</span></div></header><div className="ops-builds-grid"><section className="card ops-builds-panel" aria-labelledby="draft-heading"><header className="ops-builds-panel-head"><div><h2 className="t-sub" id="draft-heading">{state === "failed" ? "Doesn't match" : "Shop facts"}</h2></div><strong>6 facts</strong></header><aside className="ops-builds-question"><span>Ask next</span><strong>What is the finished opening width?</strong><p>Confirm the actual opening before cutting; the earlier call supplied a different measurement.</p></aside><div className="ops-builds-facts">{["Finished width", "Finished height", "Hinge side"].map((label, index) => <article className={`ops-builds-fact ${index === 0 ? "is-conflict" : ""}`} key={label}><div className="ops-builds-fact-top"><div><span>{label}</span><strong>{index === 2 ? "Left" : `${index === 0 ? 144 : 72} in`}</strong></div><em>{index === 0 ? "Doesn't match" : "Needs confirmation"}</em></div><p className="ops-builds-reference">[INTERNAL TEST] Original call, October 29 at 12:42 PM</p><blockquote>“The opening is about twelve feet, but measure it before cutting.” <Link href="#draft-heading">From the call</Link></blockquote><div className="ops-builds-actions">{["Confirm", "Shop estimate", "Drop"].map(action => <form key={action}><button className={`btn ${action === "Confirm" ? "btn--go" : "btn--edge"}`}><span className="ops-builds-action-label">{action}</span><span className="ops-builds-action-note" aria-hidden="true">{action === "Confirm" ? "Verified by the shop" : "Keep the original source"}</span></button></form>)}</div><details className="ops-builds-correct"><summary>Correct this number</summary><form className="ops-builds-inline-form"><label htmlFor={`${fixtureDomPrefix}-fact-${index}`}><span>New {label.toLowerCase()}</span><input id={`${fixtureDomPrefix}-fact-${index}`} type="number" min="0.01" step="0.01" inputMode="decimal" defaultValue={144} /></label><button className="btn btn--edge">Propose change</button></form></details></article>)}</div><footer className="ops-builds-lock"><div><span>Preview only</span><strong>Fabrication stays blocked.</strong><p>Resolve the conflicting width before locking.</p></div><form><button className="btn btn--go" disabled>Lock Build Sheet 2</button></form></footer><section className="ops-builds-canvas" aria-labelledby="build-canvas-heading"><header><h2 className="t-sub" id="build-canvas-heading">Build drawing</h2><p>Build Sheet 1</p></header><div className="ops-builds-canvas-body">{empty ? <div className="ops-builds-canvas-empty"><strong>The drawing needs a complete locked geometry.</strong><p>No dimensions are guessed.</p></div> : <div className="ops-builds-canvas-grid"><BuildSheetDrawing drawing={{ sourceBuildSheetNumber: 1, width: 144, height: 72, stockSize: 2, railCount: 3, hingeSide: "left", latchSide: "right", fabricationReady: false }} /><dl><div><dt>Finished size</dt><dd>144 × 72 in</dd></div><div><dt>Frame</dt><dd>2 in stock · 3 rails</dd></div><div><dt>Hardware</dt><dd>Hinges left · latch right</dd></div></dl></div>}</div></section></section><div className="ops-builds-rail"><section className="card ops-builds-panel" aria-labelledby="sheets-heading"><header className="ops-builds-panel-head"><div><span className="t-caption">Read-only record</span><h2 className="t-sub" id="sheets-heading">Locked history</h2></div><strong>{empty ? 0 : 1}</strong></header>{empty ? <p className="ops-builds-empty">No locked Build Sheet yet.</p> : <div className="ops-builds-sheets"><article className="is-current"><details><summary><span><em>Current</em><strong>Build Sheet 1</strong></span><time>Oct 29, 12:42 PM</time></summary><div className="ops-builds-sheet-body"><dl><div><dt>width</dt><dd>144 in</dd></div></dl><p>Preview only — fabrication outputs blocked.</p><small>Locked by [INTERNAL TEST] Daniel. This record cannot be edited.</small></div></details></article></div>}</section><section className="card ops-builds-panel" aria-labelledby="paperwork-heading"><header className="ops-builds-panel-head"><div><h2 className="t-sub" id="paperwork-heading">Paperwork</h2></div><strong>0</strong></header><p className="ops-builds-empty">Lock a Build Sheet to file its drawing and DXF manifest.</p></section></div></div></div>
  if (surface === "customer") return <main className="glass-page glass-page-brand" style={{ "--font-mcsw-customer": "var(--font-chivo)" } as CSSProperties}>{empty ? <section className="glass-closed"><span>MCSW Customer Page</span><h1>This page is closed</h1><p>Need the shop? Give us a call.</p><a href="tel:+16155550100">Call the shop</a></section> : <article className="glass-clipboard"><header><div className="glass-brand-lockup"><Image src="/images/optimized/mcs_welding_logo.webp" alt="MCS Welding" width={240} height={160} sizes="72px" unoptimized /><strong>Customer Page</strong></div><div className="glass-contact"><span>Call the shop</span><a href="tel:+16155550100">(615) 555-0100</a></div></header><section className="glass-job"><span>Your job</span><h1>{customer}&apos;s architectural driveway gate and pedestrian opening</h1><form className="glass-correction"><button>Something wrong with this?</button></form></section><section className="glass-promise"><span>Timing</span><strong>Friday, October 30</strong><p>We are confirming hinge clearance and the final opening measurement before fabrication.</p><div className="glass-promise-history"><p><del>Thursday, October 29</del><span>Waiting for the final site measurement.</span></p></div></section><ol className="glass-traveler" aria-label="Job status">{["Received", "Quoted", "Scheduled", "In progress", "Finished"].map((label, index) => <li key={label} className={index < 3 ? "is-done" : index === 3 ? "is-current" : ""}><i>{index < 3 ? "✓" : index === 3 ? "Now" : ""}</i><span>{label}</span></li>)}</ol><p className="glass-runner"><strong>Daniel</strong> is running your job.</p><section className="glass-money"><h2>Price &amp; Invoice</h2><p><span>Approved quote</span><strong>$1,234,567.89</strong></p><p><span>Invoice TEST-123456789 · Due October 30</span><strong>$1,234,567.89</strong></p><a className="glass-pay" href="#">Pay invoice</a></section></article>}</main>
  return null
}
